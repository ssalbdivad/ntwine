{
  "name": "ntwine-vscode",
  "displayName": "Ntwine",
  "description": "Ask Ntwine about the code in front of you, and open Ntwine's file links in this window",
  "version": "0.1.0",
  "private": true,
  "publisher": "ssalbdivad",
  "license": "MIT",
  "author": "Colin McDonnell",
  "homepage": "https://github.com/ssalbdivad/ntwine",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ssalbdivad/ntwine.git",
    "directory": "packages/vscode"
  },
  "type": "module",
  "main": "./dist/extension.cjs",
  "icon": "dist/icon.png",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "ntwine",
    "agents",
    "claude-code",
    "codex"
  ],
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onWebviewPanel:ntwine.thread"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "commands": [
      {
        "command": "ntwine.ask",
        "title": "Ask Ntwine…",
        "category": "Ntwine"
      },
      {
        "command": "ntwine.sendToThread",
        "title": "Send to Ntwine thread…",
        "category": "Ntwine"
      },
      {
        "command": "ntwine.addToPrompt",
        "title": "Add to Ntwine prompt",
        "category": "Ntwine"
      },
      {
        "command": "ntwine.addFileToPrompt",
        "title": "Add file to Ntwine prompt",
        "category": "Ntwine"
      },
      {
        "command": "ntwine.addSelectionOrFile",
        "title": "Add selection or file to Ntwine prompt",
        "category": "Ntwine"
      },
      {
        "command": "ntwine.focusPrompt",
        "title": "Go to the prompt box",
        "category": "Ntwine"
      },
      {
        "command": "ntwine.addTerminalSelection",
        "title": "Add to Ntwine prompt",
        "category": "Ntwine"
      },
      {
        "command": "ntwine.addProblems",
        "title": "Add problems in this file to Ntwine prompt",
        "category": "Ntwine"
      },
      {
        "command": "ntwine.addTerminalOutput",
        "title": "Add last terminal command to Ntwine prompt",
        "category": "Ntwine"
      },
      {
        "command": "ntwine.askToFix",
        "title": "Ask Ntwine to fix",
        "category": "Ntwine"
      },
      {
        "command": "ntwine.reviewThread",
        "title": "Review a thread's changes…",
        "category": "Ntwine",
        "icon": "$(diff-multiple)"
      },
      {
        "command": "ntwine.openThreadInTab",
        "title": "Open thread in editor tab",
        "category": "Ntwine",
        "icon": "$(window)"
      },
      {
        "command": "ntwine.sidebar.queue",
        "title": "Back to queue",
        "category": "Ntwine",
        "icon": "$(arrow-left)"
      },
      {
        "command": "ntwine.sidebar.newThread",
        "title": "New thread",
        "category": "Ntwine",
        "icon": "$(add)"
      },
      {
        "command": "ntwine.sidebar.jump",
        "title": "Jump to a thread",
        "category": "Ntwine",
        "icon": "$(search)"
      },
      {
        "command": "ntwine.sidebar.settings",
        "title": "Settings",
        "category": "Ntwine",
        "icon": "$(gear)"
      },
      {
        "command": "ntwine.sidebar.shortcuts",
        "title": "Keyboard shortcuts",
        "category": "Ntwine",
        "icon": "$(keyboard)"
      },
      {
        "command": "ntwine.open",
        "title": "Open in browser",
        "category": "Ntwine",
        "icon": "$(link-external)"
      },
      {
        "command": "ntwine.sidebar.reload",
        "title": "Reload sidebar",
        "category": "Ntwine",
        "icon": "$(refresh)"
      },
      {
        "command": "ntwine.showLog",
        "title": "Show log",
        "category": "Ntwine"
      },
      {
        "command": "ntwine.reconnect",
        "title": "Reconnect",
        "category": "Ntwine"
      }
    ],
    "submenus": [
      {
        "id": "ntwine.editor",
        "label": "Ntwine"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "submenu": "ntwine.editor",
          "group": "ntwine"
        }
      ],
      "ntwine.editor": [
        {
          "command": "ntwine.ask",
          "group": "ntwine@1"
        },
        {
          "command": "ntwine.sendToThread",
          "group": "ntwine@2"
        },
        {
          "command": "ntwine.addToPrompt",
          "group": "ntwine@3"
        },
        {
          "command": "ntwine.addFileToPrompt",
          "group": "ntwine@4"
        },
        {
          "command": "ntwine.addProblems",
          "when": "config.ntwine.useSidebar",
          "group": "ntwine@5"
        }
      ],
      "explorer/context": [
        {
          "command": "ntwine.ask",
          "when": "!explorerResourceIsFolder",
          "group": "ntwine@1"
        },
        {
          "command": "ntwine.addFileToPrompt",
          "when": "!explorerResourceIsFolder",
          "group": "ntwine@2"
        }
      ],
      "editor/title/context": [
        {
          "command": "ntwine.addFileToPrompt",
          "when": "resourceScheme == file",
          "group": "ntwine@1"
        }
      ],
      "terminal/context": [
        {
          "command": "ntwine.addTerminalSelection",
          "when": "terminalTextSelected && config.ntwine.useSidebar",
          "group": "ntwine@1"
        },
        {
          "command": "ntwine.addTerminalOutput",
          "when": "config.ntwine.useSidebar",
          "group": "ntwine@2"
        }
      ],
      "view/title": [
        {
          "command": "ntwine.sidebar.queue",
          "when": "view == ntwine.sidebar && ntwine.sidebarView == thread",
          "group": "navigation@1"
        },
        {
          "command": "ntwine.sidebar.newThread",
          "when": "view == ntwine.sidebar && ntwine.sidebarView && ntwine.sidebarView != thread",
          "group": "navigation@2"
        },
        {
          "command": "ntwine.sidebar.jump",
          "when": "view == ntwine.sidebar && ntwine.sidebarView",
          "group": "navigation@3"
        },
        {
          "command": "ntwine.sidebar.settings",
          "when": "view == ntwine.sidebar && ntwine.sidebarView",
          "group": "navigation@4"
        },
        {
          "command": "ntwine.openThreadInTab",
          "when": "view == ntwine.sidebar && ntwine.sidebarView == thread",
          "group": "ntwine@0"
        },
        {
          "command": "ntwine.sidebar.reload",
          "when": "view == ntwine.sidebar",
          "group": "ntwine@1"
        },
        {
          "command": "ntwine.open",
          "when": "view == ntwine.sidebar",
          "group": "ntwine@2"
        },
        {
          "command": "ntwine.sidebar.shortcuts",
          "when": "view == ntwine.sidebar && ntwine.sidebarView",
          "group": "ntwine@3"
        }
      ],
      "commandPalette": [
        {
          "command": "ntwine.askToFix",
          "when": "false"
        },
        {
          "command": "ntwine.addTerminalSelection",
          "when": "false"
        },
        {
          "command": "ntwine.addSelectionOrFile",
          "when": "false"
        },
        {
          "command": "ntwine.addProblems",
          "when": "config.ntwine.useSidebar"
        },
        {
          "command": "ntwine.addTerminalOutput",
          "when": "config.ntwine.useSidebar"
        }
      ]
    },
    "keybindings": [
      {
        "command": "ntwine.addToPrompt",
        "key": "ctrl+i",
        "mac": "cmd+i",
        "when": "editorTextFocus && editorHasSelection"
      },
      {
        "command": "ntwine.addToPrompt",
        "key": "ctrl+l",
        "mac": "cmd+l",
        "when": "editorTextFocus && editorHasSelection"
      },
      {
        "command": "ntwine.focusPrompt",
        "key": "ctrl+l",
        "mac": "cmd+l",
        "when": "editorTextFocus && !editorHasSelection && config.ntwine.useSidebar"
      },
      {
        "command": "ntwine.addSelectionOrFile",
        "key": "alt+k",
        "mac": "alt+k",
        "when": "editorTextFocus && !ntwine.claudeCodeInstalled"
      }
    ],
    "configuration": {
      "title": "Ntwine",
      "properties": {
        "ntwine.serverUrl": {
          "type": "string",
          "default": "",
          "markdownDescription": "The Ntwine server's address, such as `http://127.0.0.1:9393`. Leave empty to find the Ntwine running on this machine."
        },
        "ntwine.openFileLinks": {
          "type": "boolean",
          "default": true,
          "description": "Open file links from Ntwine in this window"
        },
        "ntwine.shareEditorState": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Share what you have in front of you in this editor with Ntwine: the file you are in and what you have selected, with its text, goes with every message you send from the Ntwine sidebar, and Ntwine's agents can read it — with your open tabs and the editor's errors and warnings — when they need it. So you can ask about \"this\" without pasting it. The eye on the sidebar's prompt box is this setting. Turn it off to keep the editor to yourself: only what you add to a prompt goes. Text from files that may hold secrets (`.env`, keys, credentials) is never sent on its own."
        },
        "ntwine.matchEditorTheme": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show Ntwine in your color theme's colors, so the sidebar, and a thread you open in an editor tab, match the rest of the editor. Turn it off to see Ntwine's own colors. Either way, Ntwine follows your theme between light and dark."
        },
        "ntwine.selectionHint": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show a quiet hint at the end of what you select in the editor, `Ctrl+L to add to Ntwine` (`⌘L` on macOS), while Ntwine is running. Not in diffs, and not for a select-all. The chord works either way."
        },
        "ntwine.useSidebar": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Put what you add from the editor — **Add to Ntwine prompt** (`Ctrl+L`), a file, a problem's **Ask Ntwine to fix**, a terminal selection — and **Ask Ntwine…** and **Send to Ntwine thread…** into the Ntwine sidebar's prompt box, to write the rest there. Turn it off to send selections and files to Ntwine in your browser, and to type Ask and Send messages in an input box."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ntwine",
          "title": "Ntwine",
          "icon": "media/ntwine.svg"
        }
      ]
    },
    "views": {
      "ntwine": [
        {
          "type": "webview",
          "id": "ntwine.sidebar",
          "name": "Ntwine"
        }
      ]
    }
  },
  "scripts": {
    "build": "nub scripts/build.ts",
    "package": "nub scripts/build.ts && nubx -y -p @vscode/vsce@3.9.2 vsce package --no-dependencies --out dist/",
    "e2e": "nub scripts/e2e.ts"
  },
  "dependencies": {
    "ws": "^8.18"
  },
  "devDependencies": {
    "@ntwine/server": "workspace:*",
    "@ntwine/shared": "workspace:*",
    "@types/node": "^24",
    "@types/vscode": "1.90.0",
    "@types/ws": "^8.5",
    "@vscode/test-electron": "^3.1.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.7"
  }
}
