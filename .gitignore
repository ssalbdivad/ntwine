/scratch/
.ntwine/

# per-user Claude Code overrides
.claude/settings.local.json
# Claude Code local state + transient agent worktrees (never commit these)
.claude/worktrees/
.claude/jobs/

# ad hoc CDP verification screenshots (scripts/shot.mjs output; see ntwine:adhoc-cdp skill)
.adhoc-shots/

# dependencies + build artifacts
node_modules/
dist/
build/
out/
*.tsbuildinfo
.turbo/
.cache/
coverage/
.vite/
web-dist/
/tmp/
/artifacts/

# os / editor cruft
.DS_Store
*.log

# local runtime scratch / demo artifacts
/demo-perm.txt
*.db
*.db-wal
*.db-shm

# ntwine prepack-staged runtime closures (regenerated by scripts/prepare-package.mjs)
/runtime/
/packages/server-release/runtime/
package.json.publish-backup

# ad hoc QA screenshots — evidence for a single effort, not repo content
/attachments/
# stale pre-hoist duplicate of packages/ (see ARCHITECTURE.md "Repo layout"); safe to delete
/ui/

# Secrets. ntwine reads no dotenv file and should not start — this rule exists so that a stray one
# never becomes committable, and it is deliberately broad. Real credentials belong OUTSIDE the repo
# (~/.ntwine-cf-token, the login keychain) or in the platform's own secret store (`wrangler secret put`).
.env
.env.*
!.env.example
*.pem
!packages/**/test/**/*.pem

# vercel CLI link state for site/ (the ntwine.app one-pager)
.vercel/

# wrangler/miniflare's local emulation state — the KV and cache SQLite files `wrangler dev` writes
# beside whatever directory it was launched from, so it appears at the root AND under packages/relay.
# Machine-local scratch that regenerates on the next run.
.wrangler/
# the gh CLI's per-machine device id, written under a repo-local XDG state dir. Machine identity, and
# so exactly the sort of thing that must never reach a commit.
.local/
