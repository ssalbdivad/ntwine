{
  "name": "ntwine",
  "version": "0.13.13",
  "private": false,
  "description": "A local web UI for running many coding agents at once",
  "keywords": [
    "ntwine",
    "agents",
    "claude-code",
    "codex",
    "orchestration",
    "dashboard",
    "ai"
  ],
  "license": "MIT",
  "author": "David Blass",
  "contributors": [
    "Colin McDonnell (original design, colinhacks/frizz)"
  ],
  "homepage": "https://github.com/ssalbdivad/ntwine",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ssalbdivad/ntwine.git"
  },
  "engines": {
    "node": "^22.13.0 || >=23.4.0"
  },
  "type": "module",
  "bin": {
    "ntwine": "./dist/ntwine.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "nub src/dev.ts",
    "desktop": "nub run --filter @ntwine/desktop dev",
    "ntwine-dev:install": "nub scripts/install-global-cli.mjs",
    "ntwine-dev:check": "nub scripts/install-global-cli.mjs --check",
    "ntwine-dev:uninstall": "nub scripts/install-global-cli.mjs --uninstall",
    "install:global": "nub scripts/install-global-cli.mjs",
    "vscode:build": "nub run --filter ntwine-vscode build",
    "vscode:package": "nub run --filter ntwine-vscode package",
    "vscode:install": "nub run --filter ntwine-vscode package && nub packages/vscode/scripts/install.ts",
    "typecheck": "tsc -b packages/shared packages/rpc packages/claude-agent-sdk-runtime packages/server packages/registrar packages/relay . packages/web packages/desktop packages/vscode",
    "test": "nub scripts/run-tests.mjs",
    "test:e2e": "nub scripts/e2e-web.mjs",
    "prepack": "node ./scripts/prepare-package.mjs --server && node ./scripts/build-package.mjs --server && node ./scripts/build-package.mjs --shell && node ./scripts/publish-manifest.mjs --strip",
    "postpack": "node ./scripts/publish-manifest.mjs --restore"
  },
  "dependencies": {
    "@parcel/watcher": "^2.5"
  },
  "devDependencies": {
    "@ntwine/server": "workspace:*",
    "@ntwine/shared": "workspace:*",
    "@types/node": "^24",
    "@types/ws": "^8.5",
    "esbuild": "^0.25.0",
    "jsqr": "^1.4.0",
    "node-pty": "1.2.0-beta.15",
    "puppeteer": "^25.3.0",
    "typescript": "^5.7",
    "ws": "^8.18"
  },
  "pnpm": {
    "overrides": {
      "react": "19.2.7",
      "react-dom": "19.2.7"
    },
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild"
    ]
  },
  "ntwineServer": {
    "package": "ntwine-server",
    "version": "0.15.23",
    "minimum": "0.15.21",
    "protocol": 1,
    "dataEpoch": 1
  }
}
